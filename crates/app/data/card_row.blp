using Gtk 4.0;

// One card in a list of cards (ADR 0042, 0044, 0077): two lines, the front
// as the title and under it the back (on All Cards, the status and the
// deck, then the back), with the card's own tags as pills at the end, an
// icon when the card is suspended and a menu. A check button shows while
// cards are being chosen. Laid out like an action row through the classes
// libadwaita styles in any row (`row > box.header > box.title`, `.title`,
// `row label.subtitle`), as the deck rows are (ADR 0041); the list draws
// the rows as one boxed list (`listview.card-list` in data/style.css). The
// texts are set in widgets/card_row.rs; card content and tag names are
// untrusted, so nothing here parses markup.
template $RappelCardRow: Gtk.Box {
  styles [
    "header",
    "card-row",
  ]

  // All Cards and the deck page, while cards are being chosen. It only
  // shows the state: the row itself is what is activated (a click, Enter
  // or Space).
  Gtk.CheckButton check {
    visible: false;
    can-target: false;
    focusable: false;
    valign: center;
  }

  Gtk.Box {
    orientation: vertical;
    hexpand: true;
    valign: center;

    styles [
      "title",
    ]

    // The front, on one line, its formulas drawn (render/math_line.rs);
    // never markup. Dimmed while the card is suspended.
    $RappelMathLine front_line {
      styles [
        "title",
      ]
    }

    // The second line: on All Cards the status and the deck, then the
    // back (only the status and the deck on a narrow window); on the deck
    // page the back alone. Dimmed and smaller (libadwaita's `row
    // label.subtitle`); each ends in "…" when the line is too short.
    Gtk.Box detail_box {
      spacing: 6;

      // All Cards only: "Due in 3 days · Maths ·", plain text.
      Gtk.Label caption_label {
        visible: false;
        use-markup: false;
        single-line-mode: true;
        ellipsize: end;
        xalign: 0;

        styles [
          "subtitle",
        ]
      }

      $RappelMathLine back_line {
        hexpand: true;

        styles [
          "subtitle",
        ]
      }
    }
  }

  // The tags this card has and not every listed card (those are said once
  // above the list), at the row's end. Not focusable: the row's accessible
  // label says every tag.
  $RappelTagPills tag_pills {
    single-line: true;
    valign: center;
  }

  // A suspended card is not studied (ADR 0035). The icon has the word as
  // its tooltip and accessible label; the row's label says it too.
  Gtk.Image suspended_icon {
    visible: false;
    icon-name: "media-playback-pause-symbolic";
    tooltip-text: _("Suspended");
    valign: center;

    accessibility {
      label: _("Suspended");
    }

    styles [
      "dimmed",
    ]
  }

  Gtk.MenuButton menu_button {
    icon-name: "view-more-symbolic";
    tooltip-text: _("Card Actions");
    valign: center;
    // The menu is given on first use (widgets/card_row.rs,
    // `ui::rows::menu_on_demand`).

    styles [
      "flat",
    ]
  }
}

menu card_menu {
  section {
    item (_("_Edit…"), "row.edit")
    item (_("Card _Information"), "row.info")
  }

  // Suspend and Unsuspend share a place: the one that does nothing for the
  // bound card is disabled by the row and hidden by its menu.
  section {
    item {
      label: _("_Suspend");
      action: "row.suspend";
      hidden-when: "action-disabled";
    }

    item {
      label: _("_Unsuspend");
      action: "row.unsuspend";
      hidden-when: "action-disabled";
    }

    item (_("_Reset Progress"), "row.reset")
    // Disabled when there is no other deck to move the card to
    // (`dialogs::move_card::offered`).
    item (_("_Move to Deck…"), "row.move")
    item (_("_Delete"), "row.delete")
  }
}
