using Gtk 4.0;
using Adw 1;

// One deck: its cards, or an empty state. The title (the deck name) and
// the subtitle (what there is to study) are set in pages/deck_page.rs;
// NavigationPage:title and AdwWindowTitle are plain text.
template $RappelDeckPage: Adw.NavigationPage {
  // At most three controls per header side (brief): on a narrow window
  // the deck page header (Back, New Card, title, Study, Select, menu and
  // the window buttons) does not fit, so Study moves to a bottom bar, as
  // the HIG's adaptive header bars do. The bin's size request is the
  // window's minimum (data/window.blp); AdwBreakpointBin needs one.
  child: Adw.BreakpointBin {
    width-request: 360;
    height-request: 294;

    // A phone: in selection mode Select All and the action bar keep only
    // their icons, as on All Cards (pages/deck_page.rs follows it and the
    // breakpoint below). It comes first: when both match, the last one
    // applies (AdwBreakpointBin docs: "If multiple breakpoints can be used
    // for the current size, the last one is used").
    Adw.Breakpoint selection_narrow {
      condition ("max-width: 500sp")
    }

    Adw.Breakpoint breakpoint {
      condition ("max-width: 400sp")

      // Only one Study button has the Alt+S mnemonic at a time: while the
      // bar slides away after the breakpoint unapplies, both buttons are
      // mapped, and two equal mnemonics would only cycle the focus
      // (GtkWindow mnemonics). The setters revert at once on unapply, so
      // the bar loses its mnemonic as the header button comes back.
      setters {
        header_study_button.visible: false;
        select_slot.visible: false;
        bar_study_button.label: _("_Study");
        bar_study_button.use-underline: true;
      }
    }

    child: Adw.ToolbarView {
      // While cards are being chosen the shared header of selection mode
      // takes its place (ui/selection.rs).
      [top]
      Adw.HeaderBar header {
        title-widget: Adw.WindowTitle window_title {};

        [start]
        Gtk.Button {
          icon-name: "list-add-symbolic";
          action-name: "deck.new-card";
          tooltip-text: _("New Card");

          accessibility {
            label: _("New Card");
          }
        }

        [end]
        // Its "Study Cards Tagged" submenu is filled when it opens
        // (pages/deck_page.rs, `update_tag_menu`).
        Gtk.MenuButton deck_menu_button {
          icon-name: "view-more-symbolic";
          menu-model: deck_menu;
          tooltip-text: _("Deck Menu");

          accessibility {
            label: _("Deck Menu");
          }
        }

        // Selection mode (HIG, "Selection mode"), as on All Cards; disabled
        // while the deck has no card. On a narrow window it moves to the
        // bottom bar, so the title has the room (ADR 0071): the slot is what
        // the breakpoint hides, as selection mode shows and hides the button
        // itself.
        [end]
        Gtk.Box select_slot {
          Gtk.Button select_button {
            icon-name: "selection-mode-symbolic";
            action-name: "selection.choose";
            tooltip-text: _("Select Cards");

            accessibility {
              label: _("Select Cards");
            }
          }
        }

        // Disabled when nothing is due and no new card is left for today.
        // On a narrow window it moves to the bottom bar.
        [end]
        Gtk.Button header_study_button {
          label: _("_Study");
          use-underline: true;
          action-name: "deck.study";

          styles [
            "suggested-action",
          ]
        }
      }

      // How many cards are chosen, Select All and Cancel; the page cannot
      // be popped then, so Back hides.
      [top]
      $RappelSelectionHeader selection_header {
        visible: false;
      }

      content: Gtk.Stack content_stack {
        Gtk.StackPage {
          name: "empty";

          // Short (a phone held sideways, or the on-screen keyboard up), the
          // empty state is `compact` so its button stays on screen (ADR 0058;
          // `ui::breakpoint`). A bin of its own: the condition is on the
          // room the page leaves it.
          child: Adw.BreakpointBin {
            width-request: 300;
            height-request: 200;

            Adw.Breakpoint empty_short {
              condition ("max-height: 400sp")
            }

            child: Adw.StatusPage empty_status {
              icon-name: "document-new-symbolic";
              title: _("No Cards Yet");
              description: _("Add a card to start learning");

              child: Gtk.Button empty_add_button {
                label: _("_Add Card");
                use-underline: true;
                action-name: "deck.new-card";
                halign: center;

                styles [
                  "pill",
                  "suggested-action",
                ]
              };
            };
          };
        }

        Gtk.StackPage {
          name: "list";

          // A GtkListView with a model, not a GtkListBox: it only creates
          // rows for what is on screen, so thousands of cards stay smooth
          // (ADR 0013). `.boxed-list` styles only GtkListBox, so the rows
          // draw the boxed list themselves (`listview.card-list` in
          // data/style.css, ADR 0077) on the window's background, as
          // boxed lists sit. The tags every card shares are said once
          // above it.
          child: Gtk.Box {
            orientation: vertical;

            // The tags every listed card has (pages/deck_page.rs
            // follows them), clamped with the list.
            Adw.Clamp {
              maximum-size: 600;

              child: $RappelCardListHeader list_header {};
            }

            Gtk.ScrolledWindow {
              hscrollbar-policy: never;
              vexpand: true;

              child: Adw.ClampScrollable {
                maximum-size: 600;

                child: Gtk.ListView card_list {
                  single-click-activate: true;

                  accessibility {
                    label: _("Cards");
                  }

                  // Not `rich-list`: the rows lay themselves out like
                  // libadwaita's action rows, with the margins of their
                  // `box.header` (data/card_row.blp).
                  styles [
                    "card-list",
                  ]
                };
              };
            }
          };
        }
      };

      // The narrow window's Study and Select Cards buttons (see the
      // breakpoint above). Shown by pages/deck_page.rs only while the
      // window is narrow and the deck has cards (`study_bar_shown`): an
      // empty deck's status page has its own action and stands alone.
      [bottom]
      Gtk.ActionBar study_bar {
        revealed: false;

        // Select Cards, from the header (see `select_slot`): shown only
        // with the bar, so only while the window is narrow.
        [start]
        Gtk.Button bar_select_button {
          icon-name: "selection-mode-symbolic";
          action-name: "selection.choose";
          tooltip-text: _("Select Cards");

          accessibility {
            label: _("Select Cards");
          }
        }

        // Study, with the whole line of what there is to study under it,
        // which the header's subtitle shortens on a phone (set in
        // pages/deck_page.rs). Under the pill, not beside it: beside it the
        // French line had too little room at 360 px and was cut at the
        // window's edge; centred under it, it has the bar's whole width
        // and wraps only if even that is too narrow (ADR 0071).
        [center]
        Gtk.Box {
          orientation: vertical;
          spacing: 4;

          Gtk.Button bar_study_button {
            label: _("Study");
            action-name: "deck.study";
            halign: center;

            styles [
              "pill",
              "suggested-action",
            ]
          }

          Gtk.Label bar_counts {
            wrap: true;
            justify: center;
            xalign: 0.5;

            styles [
              "caption",
              "dimmed",
            ]
          }
        }
      }

      // The actions on the chosen cards, as on All Cards. The Study bar
      // above hides while cards are being chosen.
      [bottom]
      $RappelSelectionBar selection_bar {}
    };
  };
}

menu deck_menu {
  // Practice goes over the deck's cards without writing anything (ADR
  // 0070); disabled while the deck has none to practise.
  section {
    item {
      label: _("_Practice");
      action: "deck.practice";
    }

    item {
      label: _("_Statistics");
      action: "deck.statistics";
    }
  }

  // Changes to the deck itself, apart from what it shows. Merge Into… is
  // disabled while there is no other deck (dialogs/merge_deck.rs); Archive
  // goes back to the deck list, with an Undo toast (ADR 0068).
  section {
    item {
      label: _("_Merge Into…");
      action: "deck.merge";
    }

    item {
      label: _("_Archive");
      action: "deck.archive";
    }
  }
}
