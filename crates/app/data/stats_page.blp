using Gtk 4.0;
using Adw 1;

// The statistics of every deck or of one: a card with three views of 30
// days, and the Memory list. The texts are set in pages/stats_page.rs; the subtitle is a deck
// name (untrusted), which AdwWindowTitle shows as plain text.
template $RappelStatsPage: Adw.NavigationPage {
  title: _("Statistics");

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle window_title {
        title: _("Statistics");
      };
    }

    content: Gtk.Stack content_stack {
      Gtk.StackPage {
        name: "empty";

        // The brief's empty state: icon, title, one sentence, one pill
        // button. The button goes back (`navigation.pop`, an action of
        // AdwNavigationView); its label is set in pages/stats_page.rs.
        // A plain pill: going back is navigation, not the action the page
        // suggests (the HIG keeps `suggested-action` for that; ADR 0058).
        // Short (a phone held sideways, or the on-screen keyboard up), the
        // empty state is `compact` so its button stays on screen (ADR 0058;
        // `ui::breakpoint`). A bin of its own: the condition is on the
        // room the page leaves it.
        child: Adw.BreakpointBin {
          width-request: 300;
          height-request: 200;

          Adw.Breakpoint empty_short {
            condition ("max-height: 400sp")
          }

          child: Adw.StatusPage empty_status {
            icon-name: "document-open-recent-symbolic";
            title: _("No Statistics Yet");
            description: _("Study some cards to see your progress here");

            child: Gtk.Button back_button {
              use-underline: true;
              halign: center;
              action-name: "navigation.pop";

              styles [
                "pill",
              ]
            };
          };
        };
      }

      Gtk.StackPage {
        name: "stats";

        // Design D, a month at a time (ADR 0078): one card with a switch
        // for the three views, the selected day's and the period's
        // figures, the chart and the paging buttons; under it, the Memory
        // list. Narrow (a phone), the legend goes under the figures.
        child: Adw.BreakpointBin {
          width-request: 300;
          height-request: 200;

          Adw.Breakpoint {
            condition ("max-width: 500sp")

            setters {
              head_box.orientation: vertical;
              legend_box.halign: start;
            }
          }

          child: Gtk.ScrolledWindow {
            hscrollbar-policy: never;

            child: Adw.Clamp {
              maximum-size: 600;
              margin-top: 24;
              margin-bottom: 24;
              margin-start: 12;
              margin-end: 12;

              child: Gtk.Box {
                orientation: vertical;
                spacing: 24;

                Gtk.Box {
                  orientation: vertical;

                  styles [
                    "card",
                  ]

                  Gtk.Box {
                    orientation: vertical;
                    spacing: 12;
                    margin-top: 12;
                    margin-bottom: 12;
                    margin-start: 12;
                    margin-end: 12;

                    // The view; pages/stats_page.rs follows `active-name`.
                    Adw.ToggleGroup view_toggles {
                      active-name: "reviews";
                      homogeneous: true;

                      accessibility {
                        label: _("Chart");
                      }

                      Adw.Toggle {
                        name: "reviews";
                        label: _("_Reviews");
                        use-underline: true;
                      }

                      Adw.Toggle {
                        name: "time";
                        label: _("_Time");
                        use-underline: true;
                      }

                      Adw.Toggle {
                        name: "forecast";
                        label: _("_Forecast");
                        use-underline: true;
                      }
                    }

                    Gtk.Box head_box {
                      spacing: 12;

                      // The selected day's figure, then the period's, as
                      // GNOME Wellbeing lays them out; a wrap box puts the
                      // second under the first when a line cannot hold
                      // both. The texts are set in pages/stats_page.rs.
                      Adw.WrapBox {
                        hexpand: true;
                        child-spacing: 36;
                        line-spacing: 6;

                        Gtk.Box {
                          orientation: vertical;

                          Gtk.Label day_key {
                            xalign: 0;
                          }

                          Gtk.Label day_value {
                            xalign: 0;

                            styles [
                              "title-1",
                              "numeric",
                            ]
                          }

                          Gtk.Label day_detail {
                            xalign: 0;

                            styles [
                              "dimmed",
                              "numeric",
                            ]
                          }
                        }

                        Gtk.Box {
                          orientation: vertical;

                          Gtk.Label period_key {
                            xalign: 0;
                          }

                          Gtk.Label period_value {
                            xalign: 0;

                            styles [
                              "title-1",
                              "numeric",
                            ]
                          }
                        }
                      }

                      // What the two parts of a bar are: the accent, and
                      // the accent at 38 % (widgets/bar_chart.rs). Reviews
                      // only. The swatches are hidden from screen readers;
                      // the words say it.
                      Gtk.Box legend_box {
                        spacing: 6;
                        valign: start;
                        halign: end;
                        margin-top: 2;

                        Gtk.DrawingArea passed_swatch {
                          content-width: 12;
                          content-height: 12;
                          valign: center;
                        }

                        Gtk.Label {
                          label: _("Passed");
                          margin-end: 12;

                          styles [
                            "caption",
                            "dimmed",
                          ]
                        }

                        Gtk.DrawingArea failed_swatch {
                          content-width: 12;
                          content-height: 12;
                          valign: center;
                        }

                        Gtk.Label {
                          label: _("Failed");

                          styles [
                            "caption",
                            "dimmed",
                          ]
                        }
                      }
                    }

                    $RappelBarChart chart {}

                    // Back or forward 30 days; hidden on the forecast,
                    // which is always the next 30 days. Next is off on
                    // the current period, Previous before the first
                    // review (pages/stats_page/text.rs).
                    Gtk.Box nav_box {
                      halign: center;
                      spacing: 12;

                      Gtk.Button previous_button {
                        icon-name: "go-previous-symbolic";
                        tooltip-text: C_("paging button", "Previous 30 Days");

                        accessibility {
                          label: C_("paging button", "Previous 30 Days");
                        }

                        styles [
                          "circular",
                        ]
                      }

                      Gtk.Button next_button {
                        icon-name: "go-next-symbolic";
                        tooltip-text: C_("paging button", "Next 30 Days");

                        accessibility {
                          label: C_("paging button", "Next 30 Days");
                        }

                        styles [
                          "circular",
                        ]
                      }
                    }
                  }
                }

                // Values the period does not change. The titles (our own
                // words, shown as plain text) and values are set in
                // pages/stats_page.rs.
                Adw.PreferencesGroup {
                  title: _("Memory");

                  Adw.ActionRow retention_row {
                    use-markup: false;

                    [suffix]
                    Gtk.Label retention_value {
                      styles [
                        "numeric",
                      ]
                    }
                  }

                  Adw.ActionRow pass_rate_row {
                    use-markup: false;

                    [suffix]
                    Gtk.Label pass_rate_value {
                      styles [
                        "numeric",
                      ]
                    }
                  }

                  Adw.ActionRow time_row {
                    use-markup: false;

                    [suffix]
                    Gtk.Label time_value {
                      styles [
                        "numeric",
                      ]
                    }
                  }
                }
              };
            };
          };
        };
      }
    };
  };
}
